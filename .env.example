# --- arb bot (plan §7) ---
ARB_MODE=observe                 # observe | dry (paper fills) | live (REAL ORDERS)
ARB_SERIES=btc-updown-5m,eth-updown-5m,sol-updown-5m,xrp-updown-5m,doge-updown-5m,btc-updown-15m,eth-updown-15m,sol-updown-15m,xrp-updown-15m,doge-updown-15m
ARB_BUY_SUM=0.985                # fee-adjusted trigger, buy side
ARB_SELL_SUM=1.015               # fee-adjusted trigger, sell side
ARB_SHARES=5
ARB_MAX_ACTIVE_USDC=10
ARB_MAX_PAIRS_PER_WINDOW=2
ARB_MIN_TAU_SEC=20
ARB_REARM_MS=1500                # cooldown per series after an attempt
ARB_UNWIND_RETRIES=3
ARB_FEE_RATE_BPS=1000            # max fee bps signed into orders (observed taker_base_fee)
ARB_FRESHNESS_MS=1000
ARB_MIN_DEPTH=5
ARB_COMPLETE_MAX_SUM=0.99        # Phase 2 — reserved
ARB_LEASH_SEC=15                 # Phase 2 — reserved
ARB_SKEW=0.50                    # Phase 5 — reserved, pinned
ARB_MAX_LOSS_USDC=3              # Phase 5 — reserved
ARB_ENGINE=node                  # node | cpp (cpp requires passing golden vectors)
ARB_ENGINE_PIPE=arb-engine       # Phase 4c — reserved

# --- observer knobs (Phase 0) ---
ARB_OBS_MIN_EVENT_MS=300         # gate counts events lasting at least this
ARB_OBS_GATE_PER_DAY=20          # gate target per side, all series combined
ARB_OBS_SAMPLE_MS=1000
ARB_OBS_XTF_DIV=0.15
ARB_OBS_NEARRES_SEC=30

# --- plumbing ---
ARB_DASH_PORT=3210
#ARB_DATA_DIR=./data

# Set by the updown bot's .env — arb-bot refuses to start on overlap:
#UPDOWN_SLUG_PREFIX=

# --- LIVE trading credentials (Phase 1) — fill these in ONLY on the trading box.
# NEVER commit a .env containing these. Live also requires ARB_LIVE_CONFIRM=yes.
ARB_LIVE_CONFIRM=no
#POLY_PRIVATE_KEY=               # signer key (the wallet that signs orders)
#POLY_FUNDER_ADDRESS=            # Polymarket proxy wallet address (holds the USDC)
#POLY_SIGNATURE_TYPE=1           # 1 = proxy wallet (plan assumption); 0 = EOA
#POLY_API_KEY=                   # optional: derived from the key when absent
#POLY_API_SECRET=
#POLY_API_PASSPHRASE=
